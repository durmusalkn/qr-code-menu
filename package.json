{
  "name": "anilar",
  "version": "0.2.0",
  "main": "expo-router/entry",
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.16",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:local": "expo start --dev-client --localhost",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test && node scripts/bundle-migrations.js --check",
    "build:dev": "eas build --platform android --profile development",
    "build:preview": "eas build --platform android --profile preview",
    "export:android": "expo export --platform android --no-bytecode",
    "update:preview": "npm run export:android && eas update --skip-bundler --channel preview",
    "db:generate": "drizzle-kit generate && node scripts/bundle-migrations.js",
    "db:check": "drizzle-kit check && node scripts/bundle-migrations.js --check"
  },
  "private": true,
  "overrides": {
    "react-native-css-interop": {
      "lightningcss": "npm:lightningcss-wasm@1.27.0"
    }
  }
}
